# Copy this file to .env and fill in real values. .env is gitignored and never committed.
# All of these are optional — the app runs fully free/offline with none set.

# Enables LLM-backed planning/claim-extraction/synthesis (Milestone 2) via
# Ollama (https://ollama.com) running on this machine: free, no API key,
# nothing leaves the machine. Requires Ollama installed and the model pulled
# first: `ollama pull qwen3:30b` (~19GB). See backend/README.md ("Choosing the
# local model") for why this model, the measured timings, and how to make
# Ollama use an integrated GPU, which is the difference between ~3 minutes and
# 15+ minutes per question.
OLLAMA_ENABLED=
OLLAMA_MODEL=qwen3:30b
OLLAMA_BASE_URL=http://localhost:11434
# "false" turns off a reasoning model's thinking phase (233s -> 7s on a trivial
# request). Models with no thinking mode accept and ignore it.
OLLAMA_THINK=false
# Context window requested per call (Ollama truncates silently past it), and
# how long the model stays loaded after the last question.
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# Enables live web search + page retrieval (Milestone 3).
# Get one at https://tavily.com — has a free tier.
TAVILY_API_KEY=

# Google Maps rating, review count, hours and dated reviews for one specific
# business (a cafe, a hotel), or a venue the question names near the pin. Optional. Needs a Google Cloud project WITH
# BILLING ENABLED (card on file); the reviews fields are in a paid tier with a
# monthly free allowance, so check current pricing first. Off when unset.
# GOOGLE_PLACES_API_KEY=

# Wikipedia/Wikivoyage lookups (free, no key). Wikimedia blocks clients that give no
# contact details, so this goes in the User-Agent; set it to your fork's URL.
# WIKIMEDIA_CONTACT=https://github.com/you/your-fork

# Set to 1 to stop reading forum posts' publication dates from the web (Reddit's date comes from a public
# archive, blogs' from their page metadata). Dates carried in URLs, such as PTT's, are still used. These
# requests never spend a search credit.
# DISABLE_POST_DATE_FETCH=1

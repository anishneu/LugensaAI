# Copy this file to .env and fill in real values. .env is gitignored and never committed.
# All of these are optional — the app runs fully free/offline with none set.

# Enables LLM-backed planning/claim-extraction/synthesis (Milestone 2).
# Billed per Anthropic's normal API usage pricing once set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Free, local alternative to ANTHROPIC_API_KEY for the same three components,
# via Ollama (https://ollama.com) running on this machine. Requires Ollama
# installed and a model pulled first (`ollama pull llama3.1`) — see
# backend/README.md. Ignored if ANTHROPIC_API_KEY is also set.
OLLAMA_ENABLED=
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Enables live web search + page retrieval (Milestone 3).
# Get one at https://tavily.com — has a free tier.
TAVILY_API_KEY=
